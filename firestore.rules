rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Videos: anyone can read, only Cloud Functions (admin SDK) can write
    match /videos/{videoId} {
      allow read: if true;
      allow write: if false;
    }

    // Categories: anyone can read, only admins can write
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Topics: only admins
    match /topics/{topicId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Users: public profiles, owner can create/update
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['createdAt']);

      // User's own categories: owner read/write
      match /categories/{catId} {
        allow read, write: if isOwner(userId);
      }

      // User's own topics: owner read/write
      match /topics/{topicId} {
        allow read, write: if isOwner(userId);
      }

      // User's video refs: owner read, Cloud Functions write only
      match /userVideos/{videoId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Invite codes: anyone can read (to validate), only admin creates
    match /inviteCodes/{code} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAuthenticated();
    }

    // Quota usage: Cloud Functions only
    match /quotaUsage/{docId} {
      allow read, write: if false;
    }

    // Favorites: owner CRUD
    match /favorites/{favId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // Fetch state and rate limits: only Cloud Functions
    match /fetchState/{docId} {
      allow read, write: if false;
    }
    match /rateLimits/{docId} {
      allow read, write: if false;
    }
  }
}
